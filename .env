# Code4Mena Legal Assistant Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/code4mena_legal
POSTGRES_DB=code4mena_legal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6380

# External LLM API Keys (Add your keys here)
GEMINI_API_KEY=AIzaSyDpWpXaUUe83zGJAOM8gLqMHr2sSznOJpU
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# Application Configuration
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev_secret_key_change_in_production
API_VERSION=v1

# Security Configuration
JWT_SECRET_KEY=dev_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Privacy Configuration
ENABLE_ANALYTICS=false
ENABLE_LOGGING=true
DATA_RETENTION_DAYS=30
PII_DETECTION_ENABLED=true

# Model Configuration
LOCAL_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_CACHE_DIR=./models
MAX_TOKENS=500
TEMPERATURE=0.3