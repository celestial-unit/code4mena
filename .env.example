# Code4Mena Legal Assistant Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code4mena_legal
POSTGRES_DB=code4mena_legal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379

# External LLM API Keys (Choose at least one)
GEMINI_API_KEY=AIzaSyCE0pSgIRGriwzqIoXTF8L-ROdAnxgpCC0
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Configuration
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your_secret_key_here_change_in_production
API_VERSION=v1

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Privacy Configuration
ENABLE_ANALYTICS=false
ENABLE_LOGGING=true
DATA_RETENTION_DAYS=30
PII_DETECTION_ENABLED=true

# Model Configuration
LOCAL_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_CACHE_DIR=./models
MAX_TOKENS=500
TEMPERATURE=0.3

# Performance Configuration
MAX_WORKERS=4
TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=100
RATE_LIMIT_PER_MINUTE=60

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin
LOG_LEVEL=INFO

# Mobile App Configuration
MOBILE_API_BASE_URL=http://localhost:8000
MOBILE_API_TIMEOUT=30
MOBILE_CACHE_ENABLED=true

# Legal Document Configuration
LEGAL_DOCS_PATH=./data/legal_documents
AUTO_UPDATE_LEGAL_DOCS=false
LEGAL_DOCS_SOURCE_URL=https://legislation.tn/api/documents

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# SSL Configuration (for production)
SSL_ENABLED=false
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# Webhook Configuration (for integrations)
WEBHOOK_URL=https://your-webhook-url.com/legal-assistant
WEBHOOK_SECRET=your_webhook_secret

# Feature Flags
FEATURE_VOICE_INPUT=false
FEATURE_DOCUMENT_UPLOAD=false
FEATURE_MULTI_LANGUAGE=true
FEATURE_OFFLINE_MODE=false